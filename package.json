{
  "name": "conex",
  "version": "0.2.0",
  "description": "whats the network rate over here: the speed you are at, and where to go for the best, drawn in glyphs (d/ay). Vite + TypeScript; every byte in the test is SHAKE256 of one sentence.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.ts\" \"vite\"",
    "build": "npm run check && vite build",
    "start": "node server/index.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test \"test/*.test.ts\"",
    "seed": "node scripts/seed.ts",
    "phone": "node scripts/phone.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cloudflared": "^0.7.1",
    "concurrently": "^9.1.0",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
